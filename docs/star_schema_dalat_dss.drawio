        <mxCell id="note_175" value="&lt;font style=&quot;font-size:12px;&quot; color=&quot;#0F172A&quot;&gt;&lt;b&gt;Fact Grain &amp;amp; Mathematical Model (WIP)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:11px;&quot;&gt;• &lt;b&gt;Grain:&lt;/b&gt; 1 row per (&lt;i&gt;date_key × theme_key × segment_key × weather_key&lt;/i&gt;).&lt;br&gt;• &lt;b&gt;Scoring Equation:&lt;/b&gt; &lt;code&gt;score(t) = w₁·Seasonal(t) + w₂·Momentary(t) + w₃·Sentiment(t) + w₄·Weather(t)&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Constraints:&lt;/b&gt; &lt;code&gt;w₁ + w₂ + w₃ + w₄ = 1&lt;/code&gt;, &lt;code&gt;0 ≤ wᵢ ≤ 1&lt;/code&gt;; &lt;code&gt;Momentary(t) = norm(Recent₇d(t) / SeasonalAvg(t))&lt;/code&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=Inter;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="570" height="110" as="geometry"/></mxCell>
        <mxCell id="note_176" value="&lt;font style=&quot;font-size:12px;&quot; color=&quot;#0F172A&quot;&gt;&lt;b&gt;Notation &amp;amp; Two-Level DW Architecture Alignment&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:11px;&quot;&gt;• &lt;b&gt;Crow&#x27;s Foot:&lt;/b&gt; &lt;code&gt;|| —— O&amp;lt;&lt;/code&gt; Mandatory One (Dimension) to Zero-or-Many (Fact).&lt;br&gt;• &lt;b&gt;Sources → Staging:&lt;/b&gt; Google Trends, Open-Meteo, Kaggle → Apache Spark + Scala ETL.&lt;br&gt;• &lt;b&gt;Storage → Front-End:&lt;/b&gt; PostgreSQL / DuckDB Star Schema → Qt Design Studio (What-If + Drill-Down).&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=Inter;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="630" y="745" width="570" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
