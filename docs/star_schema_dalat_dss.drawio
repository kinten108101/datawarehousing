        <mxCell id="edge_232" value="1 : N" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#475569;strokeWidth=1.6;startArrow=ERmandOne;startSize=10;startFill=0;endArrow=ERzeroToMany;endSize=12;endFill=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="p_dim_date_r_12" target="p_fact_signal_r_102"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_233" value="1 : N" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#475569;strokeWidth=1.6;startArrow=ERmandOne;startSize=10;startFill=0;endArrow=ERzeroToMany;endSize=12;endFill=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="p_dim_segment_r_176" target="p_fact_signal_r_110"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_234" value="1 : N" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#475569;strokeWidth=1.6;startArrow=ERmandOne;startSize=10;startFill=0;endArrow=ERzeroToMany;endSize=12;endFill=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="p_dim_theme_r_60" target="p_fact_signal_r_106"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_235" value="1 : N" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#475569;strokeWidth=1.6;startArrow=ERmandOne;startSize=10;startFill=0;endArrow=ERzeroToMany;endSize=12;endFill=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="p_dim_weather_r_204" target="p_fact_signal_r_114"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_236" value="&lt;font style=&quot;font-size:12px;&quot; color=&quot;#0F172A&quot;&gt;&lt;b&gt;PostgreSQL / DuckDB DDL, Indexing &amp;amp; What-If Query Pattern&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:11px;&quot;&gt;• &lt;b&gt;Composite PK &amp;amp; Indexes:&lt;/b&gt; &lt;code&gt;PRIMARY KEY (date_key, theme_key, segment_key, weather_key)&lt;/code&gt;; B-Tree index on &lt;code&gt;(theme_key, date_key)&lt;/code&gt; for time-window trend slicing.&lt;br&gt;• &lt;b&gt;Dynamic What-If Simulation (Qt UI):&lt;/b&gt; &lt;code&gt;(:w1 * seasonal_score + :w2 * momentary_score + :w3 * sentiment_score + :w4 * weather_score) AS simulated_score&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;CHECK Constraints:&lt;/b&gt; All normalized score columns enforce &lt;code&gt;BETWEEN 0 AND 1&lt;/code&gt; before insertion from Apache Spark + Scala ETL.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=Inter;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="680" height="115" as="geometry"/></mxCell>
        <mxCell id="note_237" value="&lt;font style=&quot;font-size:12px;&quot; color=&quot;#0F172A&quot;&gt;&lt;b&gt;Physical Column Mapping to Spec Sources&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:11px;&quot;&gt;• &lt;b&gt;Google Trends:&lt;/b&gt; Populates &lt;code&gt;trends_recent_7d&lt;/code&gt;, &lt;code&gt;trends_seasonal_avg&lt;/code&gt; → computes &lt;code&gt;seasonal_score&lt;/code&gt; and &lt;code&gt;momentary_score&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Kaggle Datasets:&lt;/b&gt; Populates &lt;code&gt;mention_count&lt;/code&gt;, &lt;code&gt;positive_review_ratio&lt;/code&gt; → computes &lt;code&gt;sentiment_score&lt;/code&gt; via Spark staging.&lt;br&gt;• &lt;b&gt;Open-Meteo API:&lt;/b&gt; Populates &lt;code&gt;temp_avg_c&lt;/code&gt;, &lt;code&gt;precip_mm&lt;/code&gt;, maps &lt;code&gt;weather_key&lt;/code&gt; → evaluates &lt;code&gt;weather_score&lt;/code&gt; against &lt;code&gt;dim_theme&lt;/code&gt; rules.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=Inter;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="740" y="750" width="680" height="115" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
